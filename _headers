/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# ★★★ 公開（インデックス解禁）時に必ず削除すること ★★★
# 下の X-Robots-Tag: noindex は現本番ホスト
# https://review-sosenkyo.murata3594.workers.dev/ に実際に効いている。
# config/site.json の indexing_enabled を true にしても、この2行が残っている限り
# 全ページがクロール対象外のままになる。削除はオーナー判断（解禁時期）に従う。
# preload 付き HSTS は独自ドメイン取得後に検討する（workers.dev では申請不可）。
https://review-sosenkyo.murata3594.workers.dev/*
  X-Robots-Tag: noindex

# 画像・フォントはファイル名にバージョンを含むため長期キャッシュで安全。
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# CSS / JS は build_dist.py が ?v=ASSET_VERSION を付けるので、
# 長期キャッシュしても新しいリリースは即座に反映される。
/*.css
  Cache-Control: public, max-age=2592000

/*.js
  Cache-Control: public, max-age=2592000

/favicon.svg
  Cache-Control: public, max-age=604800

/manifest.webmanifest
  Cache-Control: public, max-age=604800
